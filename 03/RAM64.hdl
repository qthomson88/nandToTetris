// File name: projects/3/a/RAM64.hdl
/**
 * Memory of sixty four 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    // which register in the block of 8
    DMux8Way(in = load, sel = address[0..2], a = adrA, b = adrB, c = adrC, d = adrD, e = adrE, f = adrF, g = adrG, h = adrH);
    // which ram8
    Mux8Way(a = adrA, b = adrB, c = adrC, d = adrD, e = adrE, f = adrF, g = adrG, h = adrH, sel = adr[3..5], out = loadRam8);
    DMux8Way(in = loadRam8, sel = address[3..5], a = adrA, b = adrB, c = adrC, d = adrD, e = adrE, f = adrF, g = adrG, h = adrH);
    Ram8(in = in, load = ram8AdrA, out = ramA);
    Ram8(in = in, load = ram8AdrB, out = ramB);
    Ram8(in = in, load = ram8AdrC, out = ramC);
    Ram8(in = in, load = ram8AdrD, out = ramD);
    Ram8(in = in, load = ram8AdrE, out = ramE);
    Ram8(in = in, load = ram8AdrF, out = ramF);
    Ram8(in = in, load = ram8AdrG, out = ramG);
    Ram8(in = in, load = ram8AdrH, out = ramH);
    Mux8Way16(a = regA, b = regB, c = regC, d = regD, e = regE, f = regF, g = regG, h = regH, sel = address, out = out); 
}
