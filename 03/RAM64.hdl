// File name: projects/3/a/RAM64.hdl
/**
 * Memory of sixty four 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
        // which register in the block of 8 is determined by the lower 3 bits of address
        // which ram8 is determined by load, and a dmux so only one ram8 is loading at at time, and the address is already determined as above
        DMux8Way(in = load, sel = address[3..5], a = ram8AdrA, b = ram8AdrB, c = ram8AdrC, d = ram8AdrD, e = ram8AdrE, f = ram8AdrF, g = ram8AdrG, h = ram8AdrH);
        RAM8(in = in, load = ram8AdrA, address = address[0..2], out = ramA);
        RAM8(in = in, load = ram8AdrB, address = address[0..2], out = ramB);
        RAM8(in = in, load = ram8AdrC, address = address[0..2], out = ramC);
        RAM8(in = in, load = ram8AdrD, address = address[0..2], out = ramD);
        RAM8(in = in, load = ram8AdrE, address = address[0..2], out = ramE);
        RAM8(in = in, load = ram8AdrF, address = address[0..2], out = ramF);
        RAM8(in = in, load = ram8AdrG, address = address[0..2], out = ramG);
        RAM8(in = in, load = ram8AdrH, address = address[0..2], out = ramH);
        Mux8Way16(a = ramA, b = ramB, c = ramC, d = ramD, e = ramE, f = ramF, g = ramG, h = ramH, sel = address[3..5], out = out);
}
