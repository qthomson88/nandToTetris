// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
        DMux8Way(in = load, sel = address[6..8], a = ram64AdrA, b = ram64AdrB, c = ram64AdrC, d = ram64AdrD, e = ram64AdrE, f = ram64AdrF, g = ram64AdrG, h = ram64AdrH);
        RAM64(in = in, load = ram64AdrA, address = address[0..5], out = ramA);
        RAM64(in = in, load = ram64AdrB, address = address[0..5], out = ramB);
        RAM64(in = in, load = ram64AdrC, address = address[0..5], out = ramC);
        RAM64(in = in, load = ram64AdrD, address = address[0..5], out = ramD);
        RAM64(in = in, load = ram64AdrE, address = address[0..5], out = ramE);
        RAM64(in = in, load = ram64AdrF, address = address[0..5], out = ramF);
        RAM64(in = in, load = ram64AdrG, address = address[0..5], out = ramG);
        RAM64(in = in, load = ram64AdrH, address = address[0..5], out = ramH);
        Mux8Way16(a = ramA, b = ramB, c = ramC, d = ramD, e = ramE, f = ramF, g = ramG, h = ramH, sel = address[6..8], out = out);
}
