// File name: projects/3/b/RAM16K.hdl
/**
 * Memory of 16K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
        DMux4Way(in = load, sel = address[12..13], a = ram4kAdrA, b = ram4kAdrB, c = ram4kAdrC, d = ram4kAdrD);
        RAM4K(in = in, load = ram4kAdrA, address = address[0..11], out = ramA);
        RAM4K(in = in, load = ram4kAdrB, address = address[0..11], out = ramB);
        RAM4K(in = in, load = ram4kAdrC, address = address[0..11], out = ramC);
        RAM4K(in = in, load = ram4kAdrD, address = address[0..11], out = ramD);
        Mux4Way16(a = ramA, b = ramB, c = ramC, d = ramD, sel = address[12..13], out = out);
}
