// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
        Or(a = reset, b = load, out = pcLoad1stPart);
        Or(a = pcLoad1stPart, b = inc, out = pcLoad);
        Inc16(in = regOut, out = regInc);
        Mux16(a = regOut, b = regInc, sel = inc, out = incStage);
        Mux16(a = incStage, b = in, sel = load, out = loadStage);
        Mux16(a = loadStage, b[0..15] = false, sel = reset, out = resetStage);
        Register(in = resetStage, load = pcLoad, out = out, out = regOut);
}
